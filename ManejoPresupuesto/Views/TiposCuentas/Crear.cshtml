@model TipoCuenta

@{
    ViewData["Title"] = "Crear Tipo Cuenta";
}


<h1>Crear Tipo de Cuenta</h1>

<h5>
    El tipo de cuenta se refiere a cómo podemos agrupar cuentas.
    Ejemplos: Préstamos, tarjetas de créditos, etc.
</h5>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-controller="TiposCuentas" asp-action="Crear">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        @* <input type="text" id="Nombre" name="Nombre" class="form-control"/> *@
        <input type="text" asp-for="Nombre" class="form-control"/>
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>


@*     <div class="mb-3">
        <label class="form-label" asp-for="Email"></label>
        <input asp-for="Email" class="form-control"/>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Edad"></label>
        <input class="form-control" asp-for="Edad"/>
        <span asp-validation-for="Edad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="URL" class="form-label"></label>
        <input class="form-control" asp-for="URL"/>
        <span asp-validation-for="URL" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CreditCard" class="form-label"></label>
        <input class="form-control" asp-for="CreditCard"/>
        <span asp-validation-for="CreditCard" class="text-danger"></span>
    </div> *@

    <button type="submit" class="btn btn-primary">Enviar</button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
}